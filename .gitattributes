# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.php text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.env text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.lock text eol=lf
